NEXT_PUBLIC_INFURA_TOKEN=1234567890
NEXT_PUBLIC_WC_PROJECT_ID=0987654321
# Optional: Hedera mirror node REST API base URLs (default to the public Hedera mirror nodes)
NEXT_PUBLIC_HEDERA_MIRROR_NODE_MAINNET_URL=
NEXT_PUBLIC_HEDERA_MIRROR_NODE_TESTNET_URL=
NEXT_PUBLIC_IS_OFFICIAL_HOST=false
NEXT_PUBLIC_PROD_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here
NEXT_PUBLIC_STAGING_MIXPANEL_TOKEN=1234567890 # Use Mixpanel Project TEST here, too
NEXT_PUBLIC_ETHERSCAN_API_KEY= # Etherscan API V2 key, loads recovery proposals older than the RPC history
# Optional: Safenet checks. Enabled per chain by the SAFENET_CHECKS flag in the chain config.
# Addresses and explorer default to the Safenet deployment on Gnosis Chain.
NEXT_PUBLIC_SAFENET_PROXY_URL= # Proxy that proposes a transaction to Safenet; leave empty to hide the "Request Safenet check" button
NEXT_PUBLIC_SAFENET_RPC_URL=
NEXT_PUBLIC_SAFENET_CONSENSUS_ADDRESS=
NEXT_PUBLIC_SAFENET_COORDINATOR_ADDRESS=
NEXT_PUBLIC_SAFENET_ORACLE_ADDRESSES= # Comma-separated sentinel-oracle allowlist
NEXT_PUBLIC_SAFENET_EXPLORER_URL=
